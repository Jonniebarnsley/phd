  title = {Full {{Stokes}} Modeling of Marine Ice Sheets: Influence of the Grid Size},
  shorttitle = {Full {{Stokes}} Modeling of Marine Ice Sheets},
  author = {Durand, Ga{\"e}l and Gagliardini, Olivier and Zwinger, Thomas and Meur, Emmanuel Le and Hindmarsh, Richard C. A.},
