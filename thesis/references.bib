  title = {Synchronous Retreat of {{Thwaites}} and {{Pine Island}} Glaciers in Response to External Forcings in the Presatellite Era},
  author = {Clark, Rachel W. and Wellner, Julia S. and Hillenbrand, Claus-Dieter and Totten, Rebecca L. and Smith, James A. and Miller, Lauren E. and Larter, Robert D. and Hogan, Kelly A. and Graham, Alastair G. C. and Nitsche, Frank O. and Lehrmann, Asmara A. and Lepp, Allison P. and Kirkham, James D. and Fitzgerald, Victoria T. and {Garcia-Barrera}, Georgina and Ehrmann, Werner and Wacker, Lukas},
