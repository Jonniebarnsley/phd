@article{assmannVariabilityCircumpolarDeep2013,
  title = {Variability of {{Circumpolar Deep Water}} Transport onto the {{Amundsen Sea Continental}} Shelf through a Shelf Break Trough},
  author = {Assmann, K. M. and Jenkins, A. and Shoosmith, D. R. and Walker, D. P. and Jacobs, S. S. and Nicholls, K. W.},
  year = 2013,
