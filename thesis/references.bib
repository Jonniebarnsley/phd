@article{grauPredictingMeanDepth2025,
  title = {Predicting Mean Depth and Area Fraction of {{Antarctic}} Supraglacial Melt Lakes with Physics-Based Parameterizations},
  author = {Grau, Danielle and Hussain, Azeez and Robel, Alexander A.},
  year = 2025,
  month = jul,
  journal = {Nature Communications},
  volume = {16},
  number = {1},
  pages = {6518},
  issn = {2041-1723},
  doi = {10.1038/s41467-025-61798-8},
  urldate = {2026-03-23},
  abstract = {Abstract             Despite the importance of supraglacial melt lakes to the future evolution of polar ice sheets, they are not represented in current large-scale climate and ice sheet models. In this study, we use ICESat-2 satellite surface elevation measurements to show that roughness on the Antarctic Ice Sheet surface is largely self-affine. Estimation of ice sheet surface roughness statistics then enables the development of a set of simple mathematical expressions parameterizing the average supraglacial melt lake area fraction and lake depth from statistical fitting of large simulation ensembles of water flow on random, self-affine surfaces. These parameterizations provide predictions that are generally consistent with observations, with some exceptions. Finally, we predict that on large portions of Antarctic ice shelves supraglacial lakes are likely to, on average, stay less than one meter deep and occupy less than 40\% of the ice area, absent changes in ice shelf surface roughness.},
  langid = {english},
  file = {/Users/jonniebarnsley/Zotero/storage/JNP2XJC9/Grau et al. - 2025 - Predicting mean depth and area fraction of Antarctic supraglacial melt lakes with physics-based para.pdf}
}

