@article{renObjectiveBayesianAnalysis2012a,
  title = {Objective {{Bayesian}} Analysis for a Spatial Model with Nugget Effects},
  author = {Ren, Cuirong and Sun, Dongchu and He, Chong},
  year = 2012,
  month = jul,
  journal = {Journal of Statistical Planning and Inference},
  volume = {142},
  number = {7},
  pages = {1933--1946},
  issn = {0378-3758},
  doi = {10.1016/j.jspi.2012.02.034},
  urldate = {2024-01-30},
  abstract = {The focus of this paper is objective priors for spatially correlated data with nugget effects. In addition to the Jeffreys priors and commonly used reference priors, two types of ``exact'' reference priors are derived based on improper marginal likelihoods. An ``equivalence'' theorem is developed in the sense that the expectation of any function of the score functions of the marginal likelihood function can be taken under marginal likelihoods. Interestingly, these two types of reference priors are identical. The propriety of the marginal priors and joint posteriors is studied for a large class of objective priors including all objective priors developed. Under quite general conditions, only Jeffreys-rule and ``exact'' reference priors yield proper posteriors. A simulation study shows that the exact reference priors perform better than the Jeffreys-rule prior. Two real spatial datasets are used for illustration.},
  keywords = {Frequentist coverage probability,Integrated likelihood,Jeffreys prior,Nugget effect,Propriety of posterior,Reference prior}
}

