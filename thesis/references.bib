@article{sunSpeedupPineIsland2023,
  title = {The Speedup of {{Pine Island Ice Shelf}} between 2017 and 2020: Revaluating the Importance of Ice Damage},
  shorttitle = {The Speedup of {{Pine Island Ice Shelf}} between 2017 and 2020},
  author = {Sun, Sainan and Gudmundsson, G. Hilmar},
